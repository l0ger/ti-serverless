{
  "name": "ti-serverless",
  "private": true,
  "type": "module",
  "workspaces": [
    "infra",
    "services/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "platform:bootstrap": "npm run bootstrap -w platform --",
    "platform:synth": "npm run synth -w platform --",
    "platform:deploy": "npm run deploy -w platform --",
    "person:synth": "npm run synth -w person --",
    "person:deploy": "npm run deploy -w person --"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "^10.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
